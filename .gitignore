# Rust build output
/target/
**/*.rs.bk

# Local application data (never commit camera configs, recordings or logs)
config.toml
config.toml.*
*.mkv
*.ts
*.mp4
*.m4v
*.jpg
*.jpeg
*.png
*.log
*.partial

# Secrets and local environment
.env
.env.*
*.pem
*.key
*.p12
*.pfx

# Editors / OS
.idea/
.vscode/
*.swp
.DS_Store

# Local databases and caches
*.sqlite
*.db
.cache/
# Keep documentation assets
!docs/assets/*.svg
!docs/assets/*.png
